 ***************************************************************************************************
 * norwegian qwerty in base, with persnal flavour for add layers
 ***************************************************************************************************
 * Host layout: SI *
 ***************************************************************************************************
 * ZMK layer: (note: maybe)
 ***************************************************************************************************
 *  +--------+--------+--------+--------+--------+--------+             +--------+--------+--------+--------+--------+--------+
 *  |        |        |        |        |        |        |             |        |        |        |        |        |        |
 *  +--------+--------+--------+--------+--------+--------+             +--------+--------+--------+--------+--------+--------+
 *  |        |        |        | EP ON  | EP OFF | Reset  |             |        | To SI  | To SI  |        |        |        |
 *  |        |        |        |        |        |        |             |        | Linux  | Win    |        |        |        |
 *  +--------+--------+--------+--------+--------+--------+             +--------+--------+--------+--------+--------+--------+
 *  |        |        |        |        |        | Bootl  |             |        |        |        |        |        |        |
 *  +--------+--------+--------+----+---+----+---+----+---+----+   +----+---+----+---+----+---+----+--------+--------+--------+
 *                                  |        |        |        |   |        |        |        |
 *                                  +--------+--------+--------+   +--------+--------+--------+
 *
 * - `Reset`: Reset this side of the keyboard
 * - `Bootl`: Reset this side of the keyboard to bootloader mode
 * - `EP ON`: Enable external power (enable VCC power output)
 * - `To SI Linux`: Switch keyboard layout to match SI host layout, Linux host
 * - `To SI Win`: Switch keyboard layout to match SI host layout, Windows host
 * - `EP OFF`: Disable external power (disable VCC power output)
 *
 * - Difference between "SI Linux" and "SI Windows" is in how a few special characters
 *   are implemented but for the end use there should be no difference
 *
 *   - `no_n6_lin`    -> `no_n6_win` (`^`)
 *   - `no_grave_lin` -> `no_grave_win` (`\``, `~`)
 *
 ***************************************************************************************************
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_no.h"

#define xxx &none
#define ___ &trans

// https://zmk.dev/docs/features/debouncing
&kscan0 {
    debounce-press-ms = <3>;    // Default is 5 ms
    debounce-release-ms = <4>;  // Default is 5 ms
};


/ {
    macros {
        ma_gt: ma_gt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT>
                , <&macro_tap &kp NO_LABK>
                , <&macro_release &kp LSHFT>
                ;
        };
	ma_dlr: ma_dlr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N3 &kp KP_N6>
                , <&macro_release &kp LALT>
		;
	};
	ma_caret: ma_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N9 &kp KP_N4>
                , <&macro_release &kp LALT>
		;
	};
	ma_tilde: ma_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N1 &kp KP_N2 &kp KP_N6>
                , <&macro_release &kp LALT>
		;
	};
	ma_diae: ma_diae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N1 &kp KP_N6 &kp KP_N8 >
                , <&macro_release &kp LALT>
		;
	};
	ma_acut: ma_acut {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp KP_N3 &kp KP_N8 &kp KP_N4 >
                , <&macro_release &kp LALT>
		;
	};
};

    behaviors {
        #include "behaviors_mod_morph.dtsi"

        shft_caps: tap_dance_shift_caps_lock_toggle {
            compatible = "zmk,behavior-tap-dance";
            label = "TAB_DANCE_SHIFT_CAPS_LOCK_TOGGLE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
	};

        kp_tog: behavior_kp_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&tog>;
        };
	// ¨ ^
	dia_car: dia_car {
	  compatible = "zmk,behavior-mod-morph";
	  #binding-cells = <0>;
	  bindings = <ma_diae>, <ma_caret>;
	  mods = <(MOD_LSFT|MOD_RSFT)>;
	};
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <0 1 2 3>;
            bindings = <&kp ESC>;
        };
        combo_qmark {
            timeout-ms = <50>;
            key-positions = <9 10>;
            layers = <0>;
            bindings = <&kp NO_QUES>;
        };
        combo_caps {
            timeout-ms = <50>;
            key-positions = <13 14>;
            layers = <0>;
            bindings = <&kp CAPS>;
        };
	combo_sqt {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <0>;
            bindings = <&kp NO_QUOT>;
        };
	combo_mouselayer {
            timeout-ms = <50>;
            key-positions = <25 26>;
            layers = <0 1 2 3>;
            bindings = <&tog 3>;
        };
	combo_cmenu {
            timeout-ms = <50>;
            key-positions = <33 34>;
            layers = <0 1 2 3>;
            bindings = <&kp K_CMENU>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
                default_layer {	
                        bindings = <
// |---------|---------|---------|---------|---------|----------|----|---------|---------|--------__-|---------|--------__-|---------|
// |   TAB   |   Q   <ESC>  W     |   E     |   R     |   T     |    |   Y     |   U     |   I      |   O    <?>   P       |   Å     |
// |    CTRL |   A   <CAPS> S     |   D     |   F     |   G     |    |   H     |   J     |   K       |   L     <SQT>  Ø     |  Æ     |
// |    SHFT |   Z   <MUS>  X     |   C     |   V     |   B     |    |   N     |   M     |   , ;     |   . : <CMENU> - _     |   RSHFT |
//                                    |   GUI  |                |   ENT |    |    SPC  |                |   BSPC |
   &kp TAB   &kp NO_Q  &kp NO_W  &kp NO_E  &kp NO_R  &kp NO_T       &kp NO_Y  &kp NO_U  &kp NO_I    &kp NO_O   &kp NO_P    &kp NO_ARNG
   &kp LCTRL &kp NO_A  &kp NO_S  &kp NO_D  &kp NO_F  &kp NO_G       &kp NO_H  &kp NO_J  &kp NO_K    &kp NO_L   &kp NO_OSTR &kp NO_AE
   &kp LSHFT &kp NO_Z  &kp NO_X  &kp NO_C  &kp NO_V  &kp NO_B       &kp NO_N  &kp NO_M  &kp NO_COMM &kp NO_DOT &kp NO_MINS &kp RSHFT
                                 &kp LGUI  &kp_tog LALT 1 &kp RET   &kp SPACE &kp_tog RALT 2   &no_bsdl
                        >;
                };
                lower_layer {
                        bindings = <
// |---------_|---------|---------|---------|---------|---------|----_____---|---------|---------|---------|---------|---------|---------|
// |   TAB    |   F1  <ESC> F2    |   F3    |   F4    |   F5    |            |   F6    |   F7    |   F8    |   F9    |   F10   |   F11   |
// | LCTRL    |   '|'§  |    `    |   $     |   ^     |   ~     |            |   INS   |   HM    |   PUp   |   PrS   |    x    |   F12   |
// |   SHFT   | BTCLR <MUS> BT1   |   BT2   |   BT3   |   BT4   |            |   DEL   |   END   |   PDw   |    x <CMENU> x    |   RSHFT |
   &kp TAB    &kp F1      &kp F2       &kp F3       &kp F4       &kp F5             &kp F6    &kp F7    &kp F8    &kp F9    &kp F10  &kp F11
   &kp LCTRL  &kp NO_PIPE &kp NO_GRV   &ma_dlr      &dia_car     &ma_tilde          &kp INS   &kp HOME  &kp PG_UP &kp PSCRN xxx      &kp F12    
   &kp LSHFT  &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3       &kp DEL   &kp END   &kp PG_DN xxx       xxx      &kp RSHFT  
                                       ___          ___          ___                ___       ___       ___
                        >;
                };
                raise_layer {
                        bindings = <
// |---------|---------|--------__-|--------__-|---------|---------|****|---------|---------|---------|---------|---------|---------|
// |    TAB  |   x  <ESC>   x      |    x      |   (     |   )     |    |   \     |   7 /   |   8     |    9    |     -   |   + ?   |
// |    CTRL |   x     |    x      |    x      |   [     |   ]     |    |   *     |   4 ¤   |   5 %   |    6 &  |     +   |   x     |
// |    SHFT |   x  <MUS>   <      |    >      |   {     |   }     |    |   0 =   |   1 !   |   2 "   |    3 #<CMENU> ,   |   RSHFT |
   &kp  TAB     xxx    xxx         xxx     &kp NO_LPRN &kp NO_RPRN      &kp NO_BSLS     &kp N7    &kp KP_N8 &kp KP_N9 &kp KP_SUBTRACT &no_plus  
   &kp LCTRL    xxx    xxx         xxx     &kp NO_LBKT &kp NO_RBKT      &kp KP_MULTIPLY &kp N4    &kp N5    &kp  N6   &kp KP_PLUS     xxx
   &kp LSHFT    xxx    &kp NO_LABK &ma_gt  &kp NO_LBRC &kp NO_RBRC      &kp N0          &kp N1    &kp N2    &kp N3    &kp COMMA       &kp RSHFT
                                   ___     ___         ___              ___             ___       ___
                        >;
                };
                extra_layer {
                        bindings = <
// |---------|--------------|--------__-|--------__-|---------|---------|****|---------|--------__-|---------|---------|---------|---------|
   &kp  TAB     xxx         &kp UP      xxx       xxx xxx                      xxx      &mkp LCLK      &mmv MOVE_UP    &mkp RCLK       xxx   xxx
   &kp LCTRL    &kp LEFT    &kp DOWN    &kp RIGHT xxx xxx                      xxx      &mmv MOVE_LEFT &mkp MCLK       &mmv MOVE_RIGHT xxx   xxx
   &kp LSHFT    xxx         xxx         xxx       xxx xxx                      xxx      xxx            &mmv MOVE_DOWN  xxx             xxx   &kp RSHFT
                                        ___       ___ ___                      ___      ___            ___
                        >;
                };


    };
};
